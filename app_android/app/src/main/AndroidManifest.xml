<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 传统 API（≤30）需要位置权限才能 BLE 扫描 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Android 12+（API 31+）专用 BLE 权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- 后台持续扫描：前台服务（connectedDevice 类型）常驻 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14（API 34）将 connectedDevice 前台服务类型权限提升为运行时权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Android 13+ 显示前台服务常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 文件分享（CSV/DOCX）：自建只读 Provider（零 AndroidX，替代 FileProvider） -->
        <provider
            android:name=".core.RidFileProvider"
            android:authorities="com.ridcheck.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 后台持续扫描：前台服务，App 退后台时记录不中断 -->
        <service
            android:name=".ble.RidScanService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
